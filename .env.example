# Copy to .env for local overrides. VITE_* values are inlined into the public
# bundle at build time — they are public config, so never put a secret here.
#
# Optional. The Web3Forms access key is hardcoded in src/app/App.tsx and that is
# what production ships; this only overrides it for local testing. Restart the
# dev server after changing it — Vite reads env files at startup.
#
# Web3Forms delivers only to the address that registered the key, so any key set
# here must be signed up under biz.johncrm+sales@gmail.com.
VITE_WEB3FORMS_ACCESS_KEY=
